{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "es5",
  "semi": false,
  "arrowParens": "avoid",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "singleAttributePerLine": false,
  "sortImports": true,
  "sortTailwindcss": {
    "stylesheet": "./src/styles/globals.css"
  },
  "jsdoc": true,
  "ignorePatterns": [
    "src/api/generated",
    "src/routeTree.gen.ts",
    ".devin",
    ".vscode",
    ".agents",
    "docs",
    "**/*.md",
    "pnpm-lock.yaml",
    "coverage",
    "playwright-report",
    "test-results"
  ]
}
