# ── Runtime environment variables (nginx) ─────────────────────────────────────
#
# These are set in the deployment environment (e.g. Dokploy → Environment tab)
# and are substituted into nginx.conf at container start-up via envsubst.
# They are NEVER baked into the JS bundle and NEVER visible in the browser.

# Server-to-server URL for your Mealie instance (Docker-internal)
MEALIE_INTERNAL_URL=http://mealie:9000

# Shared token used for anonymous, read-only recipe browsing
MEALIE_READONLY_TOKEN=

# Secret used to encrypt the manaaki session cookie (any long random string)
SESSION_SECRET=

# Optional: how long to wait for Mealie to start answering before giving up
# (milliseconds). Reads default to 15000, writes such as recipe imports to 120000.
# MEALIE_READ_TIMEOUT_MS=15000
# MEALIE_WRITE_TIMEOUT_MS=120000

# Optional: how many requests manaaki sends to Mealie at once (images excluded).
# Mealie stops responding when about 15 requests need its database together, and
# its own UI and other integrations share that budget. Requests over the limit
# wait up to MEALIE_QUEUE_TIMEOUT_MS, then get a 503.
# MEALIE_CONCURRENCY_LIMIT=6
# MEALIE_QUEUE_TIMEOUT_MS=10000

# Optional: Google AI key for "Create another version with AI". Without it the
# action reports that AI isn't set up. Server-only; never prefix it with VITE_.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# minimal, low, medium or high; unset uses the model's default
# GEMINI_THINKING_LEVEL=medium
# RECIPE_VERSION_DRAFTS_PER_HOUR=10

# ── Build-time environment variables (Vite) ───────────────────────────────────
#
# These are baked into the JS bundle by Vite at build time.
# In production (Dokploy), set them as Docker build args (not runtime env vars).
# Locally, set them in .env for pnpm dev.

# Public base URL of the Mealie instance (used for "View in Mealie" links)
VITE_PUBLIC_MEALIE_BASE_URL=https://mealie.scottfamily.nz

# PostHog project token (public — safe to expose in the bundle)
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=

# PostHog UI host (used for the toolbar/session recordings UI link)
VITE_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# ── Development-only ───────────────────────────────────────────────────────────
#
# Copy this file to .env and fill in the values for local development.
# The BFF server routes handle /api/* directly (no Vite proxy needed).
# Do NOT commit .env to git.
