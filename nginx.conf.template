# Honor the TLS-terminating proxy's (Traefik) X-Forwarded-Proto; nginx's own
# $scheme is http here because Traefik talks to this container over http, so
# using $scheme would tell the BFF every request is insecure. Fall back to
# $scheme only when no upstream proto header is present.
map $http_x_forwarded_proto $client_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=15r/m;

server {
    listen 80;
    root /app/html;

    # Traefik and cloudflared reach this container from private Docker
    # addresses, so the visitor is the last untrusted X-Forwarded-For hop.
    # Without this, rate limits key on Traefik's address and apply to everyone.
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    set_real_ip_from 127.0.0.1;
    set_real_ip_from fc00::/7;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    server_tokens off;
    client_max_body_size 2m;
    client_header_timeout 10s;
    client_body_timeout 30s;
    send_timeout 30s;

    include /etc/nginx/snippets/security-headers.conf;

    set $ssr_server "http://127.0.0.1:3000";
    set $posthog_assets "https://eu-assets.i.posthog.com";
    set $posthog "https://eu.i.posthog.com";

    location ~* \.map$ {
        return 404;
    }

    location /ingest/static {
        resolver 8.8.8.8 1.1.1.1 valid=60s ipv6=off;
        rewrite ^/ingest(/.*)$ $1 break;
        proxy_pass $posthog_assets;
        proxy_ssl_server_name on;
        proxy_set_header Host eu-assets.i.posthog.com;
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        proxy_hide_header Set-Cookie;
    }

    location /ingest/array {
        resolver 8.8.8.8 1.1.1.1 valid=60s ipv6=off;
        rewrite ^/ingest(/.*)$ $1 break;
        proxy_pass $posthog_assets;
        proxy_ssl_server_name on;
        proxy_set_header Host eu-assets.i.posthog.com;
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        proxy_hide_header Set-Cookie;
    }

    location /ingest {
        resolver 8.8.8.8 1.1.1.1 valid=60s ipv6=off;
        client_body_buffer_size 1m;
        rewrite ^/ingest(/.*)$ $1 break;
        proxy_pass $posthog;
        proxy_ssl_server_name on;
        proxy_set_header Host eu.i.posthog.com;
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        proxy_hide_header Set-Cookie;
    }

    location = /api/auth/oauth {
        limit_req zone=auth_limit burst=15 nodelay;
        limit_req_status 429;
        resolver 127.0.0.11 valid=10s;
        proxy_pass $ssr_server;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $client_proto;
        proxy_buffering off;
    }

    location = /api/auth/complete {
        limit_req zone=auth_limit burst=15 nodelay;
        limit_req_status 429;
        resolver 127.0.0.11 valid=10s;
        proxy_pass $ssr_server;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $client_proto;
        proxy_buffering off;
    }

    location = /api/manaaki/recipe-versions/draft {
        resolver 127.0.0.11 valid=10s;
        proxy_pass $ssr_server;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $client_proto;
        proxy_buffering off;
        proxy_read_timeout 95s;
    }

    location /api/ {
        resolver 127.0.0.11 valid=10s;
        proxy_pass $ssr_server;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $client_proto;
        proxy_buffering off;
    }

    location /assets/ {
        try_files $uri @missing_asset;
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/snippets/security-headers.conf;
    }

    location @missing_asset {
        add_header Cache-Control "no-store" always;
        include /etc/nginx/snippets/security-headers.conf;
        return 404;
    }

    location = /version.json {
        add_header Cache-Control "no-store";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    location = /manifest.webmanifest {
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    location ~* ^/(manaaki\.svg|manaaki-192\.png|manaaki-512\.png|apple-touch-icon\.png)$ {
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri @ssr;
    }

    location @ssr {
        resolver 127.0.0.11 valid=10s;
        proxy_pass $ssr_server;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $client_proto;
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml image/svg+xml;
    gzip_min_length 256;
}
