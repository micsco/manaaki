{
  "name": "manaaki",
  "version": "1.0.0",
  "description": "An alternative frontend for Mealie — the self-hosted recipe manager.",
  "main": "index.js",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "prepare": "prek install --hook-type pre-commit --hook-type pre-push || true",
    "preview": "vite preview",
    "generate": "openapi-ts",
    "check": "biome check src --files-max-size=1048576",
    "check:ci": "biome ci src --files-max-size=1048576",
    "check:fix": "biome check --write src --files-max-size=1048576",
    "format": "biome format --write src",
    "format:check": "biome format src",
    "type-check": "tsc --noEmit",
    "validate": "pnpm run type-check && pnpm run check",
    "validate:ci": "pnpm run type-check && pnpm run check:ci",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/micsco/manaaki.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "bugs": {
    "url": "https://github.com/micsco/manaaki/issues"
  },
  "homepage": "https://github.com/micsco/manaaki#readme",
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@mdi/js": "^7.4.47",
    "@posthog/react": "^1.10.3",
    "@tanstack/intent": "^0.3.5",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.17",
    "@tanstack/react-start": "^1.168.27",
    "@tanstack/router-core": "^1.171.14",
    "nuqs": "^2.9.0",
    "posthog-node": "^5.40.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "srvx": "^0.11.21",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@hey-api/openapi-ts": "^0.99.0",
    "@j178/prek": "^0.4.8",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.3",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.10"
  }
}
