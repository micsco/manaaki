{
  "name": "manaaki",
  "version": "1.0.0",
  "description": "An alternative frontend for Mealie — the self-hosted recipe manager.",
  "keywords": [],
  "homepage": "https://github.com/micsco/manaaki#readme",
  "bugs": {
    "url": "https://github.com/micsco/manaaki/issues"
  },
  "license": "ISC",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/micsco/manaaki.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/build-pwa.mjs",
    "prepare": "prek install --hook-type pre-commit --hook-type pre-push || true",
    "preview": "vite preview",
    "generate": "openapi-ts",
    "check": "oxlint && oxfmt --check",
    "check:ci": "oxlint && oxfmt --check",
    "check:fix": "oxlint --fix && oxfmt",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "type-check": "tsc --noEmit",
    "validate": "pnpm run type-check && pnpm run check",
    "validate:ci": "pnpm run type-check && pnpm run check:ci",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:pwa": "playwright test --config playwright.pwa.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:doctor": "vitest doctor",
    "test:performance": "playwright test --config playwright.performance.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@mdi/js": "^7.4.47",
    "@tanstack/intent": "0.4.0",
    "@tanstack/react-hotkeys": "^0.12.1",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.40",
    "@tanstack/react-start": "^1.168.59",
    "@tanstack/router-core": "^1.171.33",
    "nuqs": "^2.10.1",
    "posthog-js": "1.427.2",
    "posthog-node": "^5.54.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "srvx": "^1.0.5",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@j178/prek": "^0.5.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "jsdom": "^30.1.1",
    "oxfmt": "0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "packageManager": "pnpm@12.8.1"
}
